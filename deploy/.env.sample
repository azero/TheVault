# Copy to .env (never commit it) or paste into the Portainer stack's environment variables.

# --- required -------------------------------------------------------------------------------------------------
# The address people type, no trailing slash, no path. https in production (http only for localhost).
VAULT_PUBLIC_URL=https://vault.example.com
# ClosedDoor: Admin > Applications > Register a CONFIDENTIAL app.
#   Redirect URI:     https://vault.example.com/auth/callback
#   Post-logout URI:  https://vault.example.com/login
#   Grant access to everyone who may use the vault. Give the role label "admin" to vault administrators.
VAULT_OIDC_ISSUER=https://sso.example.com
VAULT_OIDC_CLIENT_ID=app_...
VAULT_OIDC_CLIENT_SECRET=cds_...

# --- browser extension ----------------------------------------------------------------------------------------
# Comma-separated Chrome extension ids allowed to sign in and call the API. The default is the id of the extension in
# this repository (it has a fixed key in manifest.json). Use your own id if you re-package or sign the extension.
VAULT_EXTENSION_IDS=gfnpigdeagehjmdcmkijcmgfadlpnlbl

# --- behind a reverse proxy -----------------------------------------------------------------------------------
# Header carrying the client address (only the right-most entry is trusted), e.g. X-Forwarded-For.
VAULT_TRUSTED_IP_HEADER=
# Address the container port is published on. Keep it on loopback (or a private network) so the proxy is the only way in;
# publishing it to the world lets anyone forge the header above.
VAULT_BIND=127.0.0.1

# --- SkyNet monitoring and protection (recommended) -----------------------------------------------------------
# In SkyNet: Agents > Create enrollment token, type "PHP / web adapter". Use the token once; TheVault keeps the key it
# receives under /data/keys and you can remove the token afterwards.
VAULT_SKYNET_URL=
VAULT_SKYNET_ENROLL_TOKEN=
# Alternative to the token: an existing agent key, plus SkyNet's command public key to accept block commands.
VAULT_SKYNET_KEY=
VAULT_SKYNET_COMMAND_PUBKEY=
VAULT_SKYNET_HOST=thevault
# Addresses SkyNet may never make TheVault block (your offices, ClosedDoor, SkyNet). CIDRs, comma separated.
VAULT_RESPONSE_ALLOWLIST=

# --- automation API (optional) ---------------------------------------------------------------------------------
# Lets scripts administer TheVault (health, accounts, sessions, audit log, SkyNet blocks) with ClosedDoor API keys. It never
# exposes vault content. Off unless true. Register the permissions in ClosedDoor first: `thevault api-scopes` prints them
# (Admin > Applications > TheVault > API permissions). Keys are verified with the OIDC client above. See docs/automation-api.md.
VAULT_API_ENABLED=
# Seconds a ClosedDoor answer about a key may be reused. 0 = ask every time (a revoked key stops at once). 30 at most is advised.
VAULT_API_CACHE_SECONDS=0
# Requests per key per minute.
VAULT_API_RATE_PER_MINUTE=120

# --- policy ---------------------------------------------------------------------------------------------------
VAULT_UNLOCK_IDLE_MINUTES=15
VAULT_AUDIT_RETENTION_DAYS=365
VAULT_MAX_ITEMS_PER_USER=20000
# Set to 1 to remove "plain JSON/CSV export" from the web app (encrypted export stays).
VAULT_DISABLE_PLAIN_EXPORT=
VAULT_DATA_PATH=/srv/thevault/data
